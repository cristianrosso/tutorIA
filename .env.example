# Copiar a .env.local. Nunca añadir claves reales al repositorio.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta de Supabase (o legacy service_role); solo servidor.
SUPABASE_SECRET_KEY=
# Dominio sintético de Auth. Definir antes de crear cuentas y mantenerlo estable.
AUTH_USERNAME_DOMAIN=usuarios.tutor-fatescipol.invalid
# Sprint 2: solo servidor. Nunca exponer en el navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RAG_DEBUG=false
TUTOR_MAX_HISTORY_MESSAGES=8
TUTOR_MAX_HISTORY_TOKENS=900
MEMORY_CONTEXT_MAX_TOKENS=420
STUDENT_PERIOD_PRICE_BOB=200
STUDENT_PERIOD_BUDGET_BOB=80
USD_TO_BOB_ACCOUNTING_RATE=6.96
AI_PRICING_VERSION=2026-09-config
OPENAI_LUNA_INPUT_COST_PER_1M=0.4
OPENAI_LUNA_OUTPUT_COST_PER_1M=1.6
OPENAI_TERRA_INPUT_COST_PER_1M=2
OPENAI_TERRA_OUTPUT_COST_PER_1M=12
OPENAI_CACHED_INPUT_COST_PER_1M=0
# Valores configurables para estimaciones locales de costo.
OPENAI_TEXT_INPUT_COST_PER_1M=2
OPENAI_TEXT_OUTPUT_COST_PER_1M=12
OPENAI_STT_COST_PER_MINUTE=0.003
OPENAI_TTS_COST_PER_MINUTE=0.015
# Alta inicial: añadir temporalmente a .env.local; eliminar después.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
