# Copiar a .env.local. Nunca añadir claves reales al repositorio.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta de Supabase (o legacy service_role); solo servidor.
SUPABASE_SECRET_KEY=
# Dominio sintético de Auth. Definir antes de crear cuentas y mantenerlo estable.
AUTH_USERNAME_DOMAIN=usuarios.tutor-fatescipol.invalid
# Sprint 2: solo servidor. Nunca exponer en el navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Valores configurables para estimaciones locales de costo.
OPENAI_TEXT_INPUT_COST_PER_1M=0.4
OPENAI_TEXT_OUTPUT_COST_PER_1M=1.6
OPENAI_STT_COST_PER_MINUTE=0.003
OPENAI_TTS_COST_PER_MINUTE=0.015
# Alta inicial: añadir temporalmente a .env.local; eliminar después.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
